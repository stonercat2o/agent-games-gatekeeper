# Copy to .env for local runs, or set these in the hosting dashboard.
# Never commit a filled-in .env.

# Port to listen on (Railway injects PORT automatically). Default 8080.
PORT=8080

# Shared HMAC secret issued by the Agent Games dashboard when the agent is
# registered ("Rotate Secret"). REQUIRED before going live — without it,
# inbound signature verification is disabled (visible on /health).
# AGENT_GAMES_HMAC_SECRET is accepted as an alias.
AGENT_GAMES_SECRET=

# Outbound signature encoding: "hex" (default) or "sha256=".
# Inbound verification accepts either form.
AGENT_GAMES_HMAC_FORMAT=hex

# How the envelope's string task_id maps to the circuit's field element:
# "keccak" (default — keccak256 of the UTF-8 id, mod p), "numeric", "hex".
GATEKEEPER_TASK_ID_MODE=keccak
